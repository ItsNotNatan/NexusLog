# =========================================================================
#  NexusLog - Variaveis de ambiente (copie para ".env" e preencha)
#  O auto-deploy cria este arquivo sozinho na primeira execucao.
# =========================================================================

# ---- PocketBase (banco) ----
# Porta 8092 para nao colidir com o ATMLog, que usa a 8091 na mesma maquina.
PB_URL=http://127.0.0.1:8092
PB_ADMIN_EMAIL=admin@nexuslog.local
PB_ADMIN_PASSWORD=TROQUE_ESTA_SENHA_FORTE

# ---- JWT (autenticacao da API) ----
# O auto-deploy sorteia um segredo forte sozinho se este ficar no padrao.
JWT_SECRET=defina_um_segredo_grande_e_aleatorio

# ---- Portas ----
# ATMLog ja ocupa 3001 / 8080 / 8082 / 8091 nesta maquina.
PORT_API=3002
PORT_FRONT=8083
